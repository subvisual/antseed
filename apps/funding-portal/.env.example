# --- MoonPay on-ramp -----------------------------------------------------------
# Create an account at https://dashboard.moonpay.com and grab your keys from the
# Developers page. Use the test keys (pk_test_/sk_test_) for sandbox — self-serve,
# no approval needed. Going live needs MoonPay's business verification (KYB).

# Public — initializes the buy widget client-side. The pk_test_ prefix runs the
# widget in sandbox (no real charges); pk_live_ runs production. Must be prefixed
# VITE_ to reach the browser bundle.
VITE_MOONPAY_PUBLISHABLE_KEY=

# Server-only — signs the widget URL (HMAC-SHA256) so the pinned destination
# wallet address can't be tampered with in the browser. Never shipped to the
# client. Required because we pass walletAddress.
MOONPAY_SECRET_KEY=

# Which chain to operate on. base-sepolia (default) for testing — pair it with a
# MoonPay pk_test_ key and the sandbox delivers test USDC. base-mainnet for
# production (real money, pk_live_ key).
VITE_ANTSEED_CHAIN=base-sepolia
